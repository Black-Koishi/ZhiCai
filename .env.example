# ── Ollama 配置 ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── 跨域来源（逗号分隔，默认本地开发地址）──────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 各智能体模型选择（可选，默认 mistral）──────────
# 可换成任何已在 Ollama 拉取的模型，例如 llama3.1、gemma3:4b
ORCHESTRATOR_MODEL=mistral
EMAIL_MODEL=mistral
COMPLIANCE_MODEL=mistral
FORECAST_MODEL=mistral

# ── 云端模型（OpenAI 兼容 API，可选）───────────────
# 将某个智能体的 *_PROVIDER 设为 openai 后，该智能体走云端（而非本地 Ollama）
# ORCHESTRATOR_PROVIDER=ollama
# EMAIL_PROVIDER=ollama
# COMPLIANCE_PROVIDER=ollama
# FORECAST_PROVIDER=ollama
# CLOUD_BASE_URL=https://api.deepseek.com/v1   # DeepSeek / OpenAI / Qwen / Moonshot 等兼容端点
# CLOUD_API_KEY=sk-xxxx

# ── 邮件服务（可选，接入真实邮箱时填写）────────────
# 需在 Gmail 中开启应用专用密码（App Password）
# EMAIL_USER=you@example.com
# EMAIL_PASS=your-app-password
